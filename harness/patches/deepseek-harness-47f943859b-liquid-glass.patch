+// @vitest-environment jsdom
+import { fireEvent, render, screen } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vitest'
+import { DEFAULT_LIQUID_SETTINGS } from '../src/liquid-settings.ts'
+import { LiquidSettingsRow } from '../src/client/LiquidSettingsRow.tsx'
+import { en, type LiquidKey } from '../src/client/locales.ts'
+import type { LiquidRuntimeState } from '../src/client/runtime-controller.ts'
+
+describe('LiquidSettingsRow', () => {
+  it('renders every control group and routes slider, palette, quality, toggle, and reset gestures', () => {
+    const state: LiquidRuntimeState = {
+      ...DEFAULT_LIQUID_SETTINGS,
+      syncStatus: 'ready',
+      writable: true,
+      engineStatus: 'ready',
+    }
+    const setLiquidField = vi.fn()
+    const resetLiquid = vi.fn()
+    render(<LiquidSettingsRow
+      useSessions={vi.fn() as never}
+      useWorkspaces={vi.fn() as never}
+      t={(key: string) => en[key as LiquidKey] ?? key}
+      useLiquid={selector => selector(state)}
+      setLiquidField={setLiquidField}
+      resetLiquid={resetLiquid}
+    />)
+
+    expect(screen.getByRole('heading', { name: 'Deep Ocean fluid background' })).toBeTruthy()
+    fireEvent.change(screen.getByRole('slider', { name: 'Fluid brightness' }), { target: { value: '52' } })
+    expect(setLiquidField).toHaveBeenCalledWith('brightness', 52)
+    fireEvent.click(screen.getByRole('button', { name: /Abyss/ }))
+    expect(setLiquidField).toHaveBeenCalledWith('palette', 'abyss')
+    fireEvent.click(screen.getByRole('button', { name: /High/ }))
+    expect(setLiquidField).toHaveBeenCalledWith('quality', 'high')
+    fireEvent.click(screen.getByRole('checkbox'))
+    expect(setLiquidField).toHaveBeenCalledWith('enabled', false)
+    fireEvent.click(screen.getByRole('button', { name: 'Restore defaults' }))
+    expect(resetLiquid).toHaveBeenCalledOnce()
+  })
+})
diff --git a/packages/client/ui-liquid-glass/tests/host.client.spec.ts b/packages/client/ui-liquid-glass/tests/host.client.spec.ts
