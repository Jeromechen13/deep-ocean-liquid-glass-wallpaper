+    const x = fromLeft ? 0.04 : 0.96;
+    const y = 0.5 + Math.sin(phase) * 0.3;
+    const direction = fromLeft ? 1.0 : -1.0;
+    const strength = config.AMBIENT_FLOW_STRENGTH * (0.42 + speed * 0.92);
+    const color = generateColor();
+    color.r *= config.AMBIENT_DYE_INTENSITY;
+    color.g *= config.AMBIENT_DYE_INTENSITY;
+    color.b *= config.AMBIENT_DYE_INTENSITY;
