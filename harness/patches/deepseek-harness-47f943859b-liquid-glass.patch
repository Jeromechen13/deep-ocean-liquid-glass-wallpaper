+/** Host registration for the user-owned Deep Ocean Liquid Glass preferences. */
+
+import type { Context } from '@deepseek-ai/cordis'
+import { settingsNamespace } from '@deepseek-ai/dsh-settings'
+import {
+  LIQUID_SETTINGS_NAMESPACE, LiquidSettingsSchema,
+} from './liquid-settings.ts'
+
+export {
+  DEFAULT_LIQUID_SETTINGS, LIQUID_PALETTES, LIQUID_QUALITIES, LIQUID_SETTINGS_NAMESPACE,
+  type LiquidPalette, type LiquidQuality, type LiquidSettings,
+} from './liquid-settings.ts'
+
+/** Host service required for durable Liquid Glass preferences. */
+export const inject = ['settings']
+
+/** Register the durable Liquid Glass namespace.
+ * @param ctx - Host Cordis context.
+ */
+export function apply(ctx: Context): void {
+  ctx.settings.register(settingsNamespace(LIQUID_SETTINGS_NAMESPACE), LiquidSettingsSchema)
+}
