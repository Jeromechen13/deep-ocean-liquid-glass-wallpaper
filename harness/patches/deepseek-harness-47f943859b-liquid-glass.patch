@@ -0,0 +1,62 @@
+/** Durable Deep Ocean fluid preferences shared by the Host and browser halves. */
+
+import z from '@deepseek-ai/schemastery'
+
+/** Settings namespace owned by the Liquid Glass plugin. */
+export const LIQUID_SETTINGS_NAMESPACE = 'ui-liquid-glass'
+
+/** Available cyan-to-blue palette treatments. */
+export const LIQUID_PALETTES = ['abyss', 'ocean', 'cyan'] as const
+
+/** GPU workload presets. */
+export const LIQUID_QUALITIES = ['eco', 'balanced', 'high'] as const
+
+/** Palette selection stored in the Host settings document. */
+export type LiquidPalette = typeof LIQUID_PALETTES[number]
+
+/** Quality selection stored in the Host settings document. */
+export type LiquidQuality = typeof LIQUID_QUALITIES[number]
+
+/** User-owned fluid presentation and simulation preferences. */
+export interface LiquidSettings {
+  /** Whether the animated surface is active. */
+  enabled: boolean
+  /** Canvas compositing opacity, in percent. */
+  opacity: number
+  /** Immediate display brightness, in percent. */
+  brightness: number
+  /** Ambient motion amount, in percent. */
+  flowSpeed: number
+  /** Pointer-driven splat force, in percent. */
+  pointerForce: number
+  /** Bloom intensity, in percent. */
+  bloom: number
+  /** Cyan-to-blue color treatment. */
+  palette: LiquidPalette
+  /** Simulation workload preset. */
+  quality: LiquidQuality
+}
+
+/** Product defaults tuned for a calm, readable Deep Ocean surface. */
+export const DEFAULT_LIQUID_SETTINGS: LiquidSettings = Object.freeze({
+  enabled: true,
+  opacity: 48,
+  brightness: 78,
+  flowSpeed: 60,
+  pointerForce: 55,
+  bloom: 30,
+  palette: 'ocean',
+  quality: 'balanced',
+})
+
+/** Durable schema and browser wire envelope for the Liquid settings namespace. */
+export const LiquidSettingsSchema: z<LiquidSettings> = z.object({
+  enabled: z.boolean().default(DEFAULT_LIQUID_SETTINGS.enabled),
+  opacity: z.number().step(1).min(0).max(100).default(DEFAULT_LIQUID_SETTINGS.opacity),
+  brightness: z.number().step(1).min(35).max(120).default(DEFAULT_LIQUID_SETTINGS.brightness),
+  flowSpeed: z.number().step(1).min(0).max(100).default(DEFAULT_LIQUID_SETTINGS.flowSpeed),
+  pointerForce: z.number().step(1).min(0).max(100).default(DEFAULT_LIQUID_SETTINGS.pointerForce),
+  bloom: z.number().step(1).min(0).max(100).default(DEFAULT_LIQUID_SETTINGS.bloom),
+  palette: z.union([...LIQUID_PALETTES]).default(DEFAULT_LIQUID_SETTINGS.palette),
+  quality: z.union([...LIQUID_QUALITIES]).default(DEFAULT_LIQUID_SETTINGS.quality),
+})
diff --git a/packages/client/ui-liquid-glass/tests/components.client.spec.tsx b/packages/client/ui-liquid-glass/tests/components.client.spec.tsx
