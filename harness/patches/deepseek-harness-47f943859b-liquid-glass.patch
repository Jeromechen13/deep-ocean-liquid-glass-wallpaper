index 0000000000000000000000000000000000000000..1ea1aaa564d69a35658376ffc73e7ca546a3e6c6
--- /dev/null
+++ b/packages/client/ui-liquid-glass/src/client/runtime-controller.ts
@@ -0,0 +1,253 @@
+/** Browser owner for the fluid Canvas, runtime bridge, and shared settings snapshot. */
+
+import {
+  createSnapshotStore, type SettingsScope, type SnapshotStore,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import {
+  DEFAULT_LIQUID_SETTINGS, type LiquidPalette, type LiquidQuality, type LiquidSettings,
+} from '../liquid-settings.ts'
+
+const PLUGIN_ID = '@deepseek-ai/dsh-client-ui-liquid-glass'
+const CANVAS_ID = 'dsh-liquid-background'
+const SCRIPT_ID = 'dsh-liquid-fluid-engine'
+const ENGINE_URL = '/fluid-wallpaper-script.js'
+const WRITE_DELAY_MS = 180
+
+/** Engine readiness shown by both control surfaces. */
+export type LiquidEngineStatus = 'loading' | 'ready' | 'fallback'
+
+/** Shared UI snapshot: durable values plus transport and engine readiness. */
+export interface LiquidRuntimeState extends LiquidSettings {
+  /** Settings namespace synchronization state. */
+  syncStatus: 'loading' | 'ready' | 'unavailable'
+  /** Whether changes persist to the Host document. */
+  writable: boolean
+  /** Current fluid engine availability. */
+  engineStatus: LiquidEngineStatus
+}
+
+interface FluidRuntimeConfig {
+  enabled?: boolean
+  flowSpeed?: number
+  pointerForce?: number
+  bloom?: number
+  palette?: LiquidPalette
+  quality?: LiquidQuality
+}
+
+interface FluidRuntime {
+  getConfig(): FluidRuntimeConfig
+  updateConfig(next: FluidRuntimeConfig): void
+  setEnabled(enabled: boolean): void
+}
+
+declare global {
+  interface Window {
+    __DSH_LIQUID_CONTROLLER__?: { dispose(): void }
+    __DSH_LIQUID_FLUID__?: FluidRuntime
+    __DSH_LIQUID_FLUID_CLEANUP__?: () => void
+    __DSH_LIQUID_OWNER__?: string
+  }
+}
+
+const SETTINGS_FIELDS = Object.keys(DEFAULT_LIQUID_SETTINGS) as Array<keyof LiquidSettings>
+
+function percent(value: unknown, min = 0, max = 100): number {
+  const parsed = typeof value === 'number' && Number.isFinite(value) ? Math.round(value) : min
+  return Math.min(max, Math.max(min, parsed))
+}
+
+function normalize<K extends keyof LiquidSettings>(field: K, value: LiquidSettings[K]): LiquidSettings[K] {
+  if (field === 'enabled') return Boolean(value) as LiquidSettings[K]
+  if (field === 'opacity' || field === 'flowSpeed' || field === 'pointerForce' || field === 'bloom') {
+    return percent(value) as LiquidSettings[K]
+  }
+  if (field === 'brightness') return percent(value, 35, 120) as LiquidSettings[K]
+  if (field === 'palette') {
+    return (value === 'abyss' || value === 'cyan' ? value : 'ocean') as LiquidSettings[K]
+  }
+  return (value === 'eco' || value === 'high' ? value : 'balanced') as LiquidSettings[K]
+}
+
+/**
+ * Own one Canvas and one WebGL context while mirroring a Host settings scope.
+ * Slider changes paint immediately, coalesce engine work to one animation
+ * frame, and persist after the gesture settles.
+ */
+export class LiquidRuntimeController {
+  /** Observable state bound into components by the slot renderer. */
+  readonly store: SnapshotStore<LiquidRuntimeState> = createSnapshotStore({
+    ...DEFAULT_LIQUID_SETTINGS,
+    syncStatus: 'loading',
+    writable: false,
+    engineStatus: 'loading',
+  })
+
+  private readonly writes = new Map<keyof LiquidSettings, ReturnType<typeof setTimeout>>()
+  private readonly unsubscribe: () => void
+  private canvas: HTMLCanvasElement | undefined
+  private script: HTMLScriptElement | undefined
+  private applyFrame: number | undefined
+  private disposed = false
+
+  /** @param host - Settings namespace mirror owned by this plugin. */
+  constructor(private readonly host: SettingsScope<LiquidSettings>) {
+    this.unsubscribe = host.subscribe(() => { this.adoptHost() })
+    this.adoptHost()
+    this.mount()
+  }
+
+  /** Preview and persist one user-owned field.
+   * @param field - field selected by the control.
+   * @param value - next validated UI value.
+   */
+  setField<K extends keyof LiquidSettings>(field: K, value: LiquidSettings[K]): void {
+    const next = normalize(field, value)
+    this.store.update((state) => { Object.assign(state, { [field]: next }) })
+    this.scheduleApply()
+    const previous = this.writes.get(field)
+    if (previous !== undefined) clearTimeout(previous)
+    const timer = setTimeout(() => {
+      this.writes.delete(field)
+      void this.host.set(field, next)
+    }, WRITE_DELAY_MS)
+    this.writes.set(field, timer)
+  }
+
+  /** Clear all user overrides and restore product defaults. */
+  reset(): void {
+    for (const timer of this.writes.values()) clearTimeout(timer)
+    this.writes.clear()
+    const current = this.store.getSnapshot()
+    this.store.set({
+      ...DEFAULT_LIQUID_SETTINGS,
+      syncStatus: current.syncStatus,
+      writable: current.writable,
+      engineStatus: current.engineStatus,
+    })
+    this.scheduleApply()
+    for (const field of SETTINGS_FIELDS) void this.host.unset(field)
+  }
+
+  /** Release listeners, timers, the owned DOM nodes, and the WebGL context. */
+  dispose(): void {
+    if (this.disposed) return
+    this.disposed = true
+    this.unsubscribe()
+    for (const timer of this.writes.values()) clearTimeout(timer)
+    this.writes.clear()
+    if (this.applyFrame !== undefined && typeof cancelAnimationFrame === 'function') {
+      cancelAnimationFrame(this.applyFrame)
+    }
+    this.applyFrame = undefined
+    if (typeof window !== 'undefined' && window.__DSH_LIQUID_CONTROLLER__ === this) {
+      window.__DSH_LIQUID_FLUID_CLEANUP__?.()
+      delete window.__DSH_LIQUID_FLUID_CLEANUP__
+      delete window.__DSH_LIQUID_CONTROLLER__
+      delete window.__DSH_LIQUID_OWNER__
+    }
+    this.script?.remove()
+    this.canvas?.remove()
+    this.script = undefined
+    this.canvas = undefined
+  }
+
+  private adoptHost(): void {
+    const snapshot = this.host.getSnapshot()
+    const current = this.store.getSnapshot()
+    if (snapshot.value === undefined) {
+      this.store.update((state) => {
+        state.syncStatus = snapshot.status === 'loading' ? 'loading' : 'unavailable'
+        state.writable = snapshot.writable
+      })
+      return
+    }
+    this.store.set({
+      ...snapshot.value,
+      syncStatus: 'ready',
+      writable: snapshot.writable,
+      engineStatus: current.engineStatus,
+    })
+    this.scheduleApply()
+  }
+
+  private mount(): void {
+    if (typeof document === 'undefined' || typeof window === 'undefined') {
+      this.store.update((state) => { state.engineStatus = 'fallback' })
+      return
+    }
+    const previous = window.__DSH_LIQUID_CONTROLLER__
+    if (previous !== undefined && previous !== this) previous.dispose()
+    window.__DSH_LIQUID_FLUID_CLEANUP__?.()
+    delete window.__DSH_LIQUID_FLUID_CLEANUP__
+    document.getElementById(CANVAS_ID)?.remove()
+    document.getElementById(SCRIPT_ID)?.remove()
+    document.querySelector('style[data-plugin="dsh-liquid-wallpaper-skin"]')?.remove()
+
+    window.__DSH_LIQUID_CONTROLLER__ = this
+    window.__DSH_LIQUID_OWNER__ = PLUGIN_ID
+
+    const canvas = document.createElement('canvas')
+    canvas.id = CANVAS_ID
+    canvas.setAttribute('aria-hidden', 'true')
+    canvas.setAttribute('role', 'presentation')
+    document.body.prepend(canvas)
+    this.canvas = canvas
+    this.applyVisuals()
+
+    const script = document.createElement('script')
+    script.id = SCRIPT_ID
+    script.src = ENGINE_URL
+    script.async = true
+    script.addEventListener('load', () => { this.attachEngine() }, { once: true })
+    script.addEventListener('error', () => {
+      canvas.dataset.fallback = 'static'
+      this.store.update((state) => { state.engineStatus = 'fallback' })
+    }, { once: true })
+    document.head.appendChild(script)
+    this.script = script
+  }
+
+  private attachEngine(): void {
+    if (this.disposed) return
+    if (window.__DSH_LIQUID_FLUID__ === undefined) {
+      this.store.update((state) => { state.engineStatus = 'fallback' })
+      return
+    }
+    this.store.update((state) => { state.engineStatus = 'ready' })
+    this.applyNow()
+  }
+
+  private scheduleApply(): void {
+    if (this.disposed || this.applyFrame !== undefined) return
+    if (typeof requestAnimationFrame !== 'function') {
+      this.applyNow()
+      return
+    }
+    this.applyFrame = requestAnimationFrame(() => {
+      this.applyFrame = undefined
+      this.applyNow()
+    })
+  }
+
+  private applyNow(): void {
+    this.applyVisuals()
+    const state = this.store.getSnapshot()
+    window.__DSH_LIQUID_FLUID__?.updateConfig({
+      enabled: state.enabled,
+      flowSpeed: state.flowSpeed / 100,
+      pointerForce: state.pointerForce / 100,
+      bloom: state.bloom / 100,
+      palette: state.palette,
+      quality: state.quality,
+    })
+  }
+
+  private applyVisuals(): void {
+    const canvas = this.canvas
+    if (canvas === undefined) return
+    const state = this.store.getSnapshot()
+    canvas.style.setProperty('--dsh-liquid-user-opacity', state.enabled ? String(state.opacity / 100) : '0')
+    canvas.style.filter = `brightness(${String(state.brightness)}%) saturate(108%)`
+  }
+}
