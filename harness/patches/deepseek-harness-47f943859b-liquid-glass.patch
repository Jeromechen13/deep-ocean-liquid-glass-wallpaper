+/** Client plugin owning the Deep Ocean Canvas and its two control surfaces. */
+
+import type { ClientContext } from '@deepseek-ai/dsh-client-runtime/client'
+import type { SettingsScope } from '@deepseek-ai/dsh-client-runtime/client'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+import type {} from '@deepseek-ai/dsh-client-ui-settings/client'
+import type {} from '@deepseek-ai/dsh-client-ui-sidebar/client'
+import {
+  LIQUID_SETTINGS_NAMESPACE, type LiquidSettings,
+} from '../liquid-settings.ts'
+import { LiquidSettingsRow } from './LiquidSettingsRow.tsx'
+import { QuickLiquidControl } from './QuickLiquidControl.tsx'
+import type {} from './contract.ts'
+import { en, zh } from './locales.ts'
+import { LiquidRuntimeController } from './runtime-controller.ts'
+import type { LiquidControlInjected } from './types.ts'
+
+const NS = 'settings.liquid'
+
+/** Required services for settings persistence, dictionaries, and slot composition. */
+export const inject = ['slots', 'locale', 'settingsScope']
+
+/** Mount the Canvas controller and register both control surfaces.
+ * @param ctx - Client root context.
+ */
+export function apply(ctx: ClientContext): void {
+  const host: SettingsScope<LiquidSettings> = ctx.settingsScope.bind<LiquidSettings>({
+    namespace: LIQUID_SETTINGS_NAMESPACE,
+  })
+  const controller = new LiquidRuntimeController(host)
+  const face = (): LiquidControlInjected => ({
+    hooks: { liquid: controller.store },
+    setLiquidField: (field, value) => { controller.setField(field, value) },
+    resetLiquid: () => { controller.reset() },
+  })
+
+  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'ui-liquid-glass: dictionaries')
+  ctx.effect(() => () => { controller.dispose() }, 'ui-liquid-glass: Canvas and WebGL lifecycle')
+
+  ctx.slots.inject('sidebar.footer.action', () => ctx.slots.register({
+    name: 'sidebar.footer.action',
+    id: 'liquid-glass',
+    order: 20,
+    locale: NS,
+    inject: face,
+  }, QuickLiquidControl))
+
+  ctx.slots.inject('settings.general.item', () => ctx.slots.register({
+    name: 'settings.general.item',
+    id: 'liquid-glass',
+    order: 15,
+    locale: NS,
+    inject: face,
+  }, LiquidSettingsRow))
+}
