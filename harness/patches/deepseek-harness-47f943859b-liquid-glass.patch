@@ -0,0 +1,61 @@
+/** Shared labeled range control for the quick and full Liquid panels. */
+
+import type { CSSProperties } from 'react'
+import type { LiquidSettings } from '../liquid-settings.ts'
+import css from './LiquidControls.module.css'
+
+/** Numeric settings fields rendered as percentage sliders. */
+export type LiquidSliderField = 'opacity' | 'brightness' | 'flowSpeed' | 'pointerForce' | 'bloom'
+
+/** Labeled slider input props. */
+export interface LiquidSliderProps {
+  /** Field persisted when the input changes. */
+  field: LiquidSliderField
+  /** Accessible and visible label. */
+  label: string
+  /** Optional supporting copy. */
+  description?: string
+  /** Current numeric value. */
+  value: number
+  /** Minimum accepted value. */
+  min?: number
+  /** Maximum accepted value. */
+  max?: number
+  /** Compact layout inside the sidebar popover. */
+  compact?: boolean
+  /** Route a new value to the shared controller. */
+  onChange: <K extends keyof LiquidSettings>(field: K, value: LiquidSettings[K]) => void
+}
+
+/** Render one percentage range with a live output value.
+ * @param props - slider presentation and write callback.
+ * @returns the labeled range row.
+ */
+export function LiquidSlider({
+  field, label, description, value, min = 0, max = 100, compact = false, onChange,
+}: LiquidSliderProps) {
+  const progress = ((value - min) / (max - min)) * 100
+  const style = { '--dsh-liquid-range-progress': `${String(progress)}%` } as CSSProperties
+  return (
+    <label className={compact ? css.sliderCompact : css.sliderRow}>
+      <span className={css.sliderHeading}>
+        <span>
+          <span className={css.sliderLabel}>{label}</span>
+          {description !== undefined && <span className={css.sliderDescription}>{description}</span>}
+        </span>
+        <output className={css.sliderValue}>{value}%</output>
+      </span>
+      <input
+        className={css.range}
+        type="range"
+        min={min}
+        max={max}
+        step={1}
+        value={value}
+        aria-label={label}
+        style={style}
+        onChange={(event) => { onChange(field, Number(event.currentTarget.value)) }}
+      />
+    </label>
+  )
+}
