+/** Complete Liquid Glass controls registered into General Settings. */
+
+import type { InjectFace, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type {} from '@deepseek-ai/dsh-client-ui-settings/client'
+import type { LiquidPalette, LiquidQuality } from '../liquid-settings.ts'
+import type { LiquidLocaleProps } from './contract.ts'
+import type { LiquidControlInjected } from './types.ts'
+import { LiquidSlider } from './LiquidSlider.tsx'
+import css from './LiquidControls.module.css'
+
+/** Composed props for the General Settings contribution. */
+export type LiquidSettingsRowProps = PropsRuntime<'settings.general.item'>
+  & LiquidLocaleProps & InjectFace<LiquidControlInjected>
+
+const PALETTES: readonly LiquidPalette[] = ['abyss', 'ocean', 'cyan']
+const QUALITIES: readonly LiquidQuality[] = ['eco', 'balanced', 'high']
+const SWATCH_CLASSES: Record<LiquidPalette, string> = {
+  abyss: css.swatchAbyss ?? '',
+  ocean: css.swatchOcean ?? '',
+  cyan: css.swatchCyan ?? '',
+}
+
+/** Render the full Deep Ocean fluid settings surface.
+ * @param props - locale and shared controller face.
+ * @returns the complete settings row.
+ */
+export function LiquidSettingsRow({
+  t, useLiquid, setLiquidField, resetLiquid,
+}: LiquidSettingsRowProps) {
+  const state = useLiquid(value => value)
+  const status = state.engineStatus === 'ready'
+    ? (state.writable ? t('status.saved') : t('status.local'))
+    : t('status.fallback')
+
+  return (
+    <section className={css.settingsRoot} aria-labelledby="dsh-liquid-settings-title">
+      <div className={css.settingsHeader}>
+        <span>
+          <h3 id="dsh-liquid-settings-title">{t('settings.title')}</h3>
+          <p>{t('settings.description')}</p>
+        </span>
+        <label className={css.switchLabel}>
+          <input
+            className={css.switchInput}
+            type="checkbox"
+            checked={state.enabled}
+            onChange={(event) => { setLiquidField('enabled', event.currentTarget.checked) }}
+          />
+          <span className={css.switchTrack} aria-hidden="true"><span /></span>
+          <span>{state.enabled ? t('enabled.on') : t('enabled.off')}</span>
+        </label>
+      </div>
+
+      <div className={css.statusLine}>
+        <span className={state.engineStatus === 'ready' ? css.liveDot : css.idleDot} aria-hidden="true" />
+        {status}
+      </div>
+
+      <div className={css.sliderGrid}>
+        <LiquidSlider field="opacity" label={t('opacity.label')} description={t('opacity.description')} value={state.opacity} onChange={setLiquidField} />
+        <LiquidSlider field="brightness" label={t('brightness.label')} description={t('brightness.description')} value={state.brightness} min={35} max={120} onChange={setLiquidField} />
+        <LiquidSlider field="flowSpeed" label={t('flow.label')} description={t('flow.description')} value={state.flowSpeed} onChange={setLiquidField} />
+        <LiquidSlider field="pointerForce" label={t('pointer.label')} description={t('pointer.description')} value={state.pointerForce} onChange={setLiquidField} />
+        <LiquidSlider field="bloom" label={t('bloom.label')} description={t('bloom.description')} value={state.bloom} onChange={setLiquidField} />
+      </div>
+
+      <fieldset className={css.choiceGroup}>
+        <legend>{t('palette.label')}</legend>
+        <p>{t('palette.description')}</p>
+        <div className={css.paletteGrid}>
+          {PALETTES.map(palette => (
+            <button
+              key={palette}
+              type="button"
+              className={state.palette === palette ? css.choiceSelected : css.choiceButton}
+              aria-pressed={state.palette === palette}
+              onClick={() => { setLiquidField('palette', palette) }}
+            >
+              <span className={`${css.swatch} ${SWATCH_CLASSES[palette]}`} aria-hidden="true" />
+              <span><strong>{t(`palette.${palette}`)}</strong><small>{t(`palette.${palette}.hint`)}</small></span>
+            </button>
+          ))}
+        </div>
+      </fieldset>
+
+      <fieldset className={css.choiceGroup}>
+        <legend>{t('quality.label')}</legend>
+        <p>{t('quality.description')}</p>
+        <div className={css.qualityGrid}>
+          {QUALITIES.map(quality => (
+            <button
+              key={quality}
+              type="button"
+              className={state.quality === quality ? css.choiceSelected : css.choiceButton}
+              aria-pressed={state.quality === quality}
+              onClick={() => { setLiquidField('quality', quality) }}
+            >
+              <strong>{t(`quality.${quality}`)}</strong>
+              <small>{t(`quality.${quality}.hint`)}</small>
+            </button>
+          ))}
+        </div>
+      </fieldset>
+
+      <div className={css.settingsFooter}>
+        <span>{t('footer.hint')}</span>
+        <button type="button" className={css.resetButton} onClick={resetLiquid}>{t('reset')}</button>
+      </div>
+    </section>
+  )
+}
