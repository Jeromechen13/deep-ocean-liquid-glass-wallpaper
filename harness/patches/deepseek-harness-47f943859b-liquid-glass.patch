@@ -0,0 +1,31 @@
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it } from 'vitest'
+import { SettingsProvider, settingsNamespace, type SettingsNamespace } from '@deepseek-ai/dsh-settings'
+import {
+  DEFAULT_LIQUID_SETTINGS, LIQUID_SETTINGS_NAMESPACE, apply, inject,
+} from '@deepseek-ai/dsh-client-ui-liquid-glass'
+
+class MemorySettings extends SettingsProvider {
+  readonly writable = true
+  protected load(): Promise<Record<string, unknown>> { return Promise.resolve({}) }
+  protected persist(_ns: SettingsNamespace, _section: Record<string, unknown>): Promise<void> {
+    return Promise.resolve()
+  }
+}
+
+describe('ui-liquid-glass Host settings', () => {
+  it('registers bounded defaults and disposes its namespace with the plugin fiber', async () => {
+    const ctx = new Context()
+    await ctx.plugin(MemorySettings).await()
+    const fiber = ctx.plugin({ inject, apply })
+    await fiber.await()
+    const ns = settingsNamespace(LIQUID_SETTINGS_NAMESPACE)
+    expect(ctx.settings.get(ns)).toEqual(DEFAULT_LIQUID_SETTINGS)
+    await ctx.settings.update(ns, { brightness: 52, palette: 'abyss', quality: 'eco' })
+    expect(ctx.settings.get(ns)).toMatchObject({ brightness: 52, palette: 'abyss', quality: 'eco' })
+    await expect(ctx.settings.update(ns, { brightness: 121 })).rejects.toThrow()
+    await expect(ctx.settings.update(ns, { palette: 'rainbow' })).rejects.toThrow()
+    await fiber.dispose()
+    expect(ctx.settings.describe().map(row => row.ns)).not.toContain(ns)
+  })
+})
diff --git a/packages/client/ui-liquid-glass/tests/runtime-controller.client.spec.ts b/packages/client/ui-liquid-glass/tests/runtime-controller.client.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4901b671a9f61df9dadce3b3a2e351223ca3aead
--- /dev/null
+++ b/packages/client/ui-liquid-glass/tests/runtime-controller.client.spec.ts
@@ -0,0 +1,72 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { stubSettingsScope } from '@deepseek-ai/dsh-client-test-runtime'
+import { DEFAULT_LIQUID_SETTINGS, type LiquidSettings } from '../src/liquid-settings.ts'
+import { LiquidRuntimeController } from '../src/client/runtime-controller.ts'
+
+afterEach(() => {
+  document.body.innerHTML = ''
+  document.head.querySelector('#dsh-liquid-fluid-engine')?.remove()
+  delete window.__DSH_LIQUID_CONTROLLER__
+  delete window.__DSH_LIQUID_FLUID__
+  delete window.__DSH_LIQUID_FLUID_CLEANUP__
+  delete window.__DSH_LIQUID_OWNER__
+  vi.useRealTimers()
+  vi.unstubAllGlobals()
+})
+
+describe('LiquidRuntimeController', () => {
+  it('shares Host values, coalesces writes, applies the engine, resets, and fully disposes', async () => {
+    vi.useFakeTimers()
+    vi.stubGlobal('requestAnimationFrame', undefined)
+    const host = stubSettingsScope<LiquidSettings>()
+    const controller = new LiquidRuntimeController(host.scope)
+    expect(document.querySelectorAll('#dsh-liquid-background')).toHaveLength(1)
+    expect(document.querySelectorAll('#dsh-liquid-fluid-engine')).toHaveLength(1)
+    expect(host.listenerCount()).toBe(1)
+
+    host.publish({ status: 'ready', value: { ...DEFAULT_LIQUID_SETTINGS }, writable: true })
+    expect(controller.store.getSnapshot()).toMatchObject({ syncStatus: 'ready', writable: true })
+
+    const updateConfig = vi.fn()
+    const cleanup = vi.fn()
+    window.__DSH_LIQUID_FLUID__ = { getConfig: () => ({}), updateConfig, setEnabled: vi.fn() }
+    window.__DSH_LIQUID_FLUID_CLEANUP__ = cleanup
+    document.querySelector<HTMLScriptElement>('#dsh-liquid-fluid-engine')!
+      .dispatchEvent(new Event('load'))
+    expect(updateConfig).toHaveBeenLastCalledWith(expect.objectContaining({ quality: 'balanced' }))
+
+    controller.setField('brightness', 55)
+    controller.setField('brightness', 54)
+    controller.setField('flowSpeed', 25)
+    expect(controller.store.getSnapshot()).toMatchObject({ brightness: 54, flowSpeed: 25 })
+    expect(document.querySelector<HTMLCanvasElement>('#dsh-liquid-background')!.style.filter)
+      .toContain('brightness(54%)')
+    await vi.advanceTimersByTimeAsync(179)
+    expect(host.set).not.toHaveBeenCalled()
+    await vi.advanceTimersByTimeAsync(1)
+    expect(host.set).toHaveBeenCalledTimes(2)
+    expect(host.set).toHaveBeenCalledWith('brightness', 54)
+
+    controller.reset()
+    expect(controller.store.getSnapshot()).toMatchObject(DEFAULT_LIQUID_SETTINGS)
+    expect(host.unset).toHaveBeenCalledTimes(Object.keys(DEFAULT_LIQUID_SETTINGS).length)
+
+    controller.dispose()
+    controller.dispose()
+    expect(cleanup).toHaveBeenCalledOnce()
+    expect(host.listenerCount()).toBe(0)
+    expect(document.querySelector('#dsh-liquid-background')).toBeNull()
+    expect(document.querySelector('#dsh-liquid-fluid-engine')).toBeNull()
+  })
+
+  it('keeps the static fallback usable when the engine asset fails', () => {
+    const host = stubSettingsScope<LiquidSettings>()
+    const controller = new LiquidRuntimeController(host.scope)
+    const script = document.querySelector<HTMLScriptElement>('#dsh-liquid-fluid-engine')!
+    script.dispatchEvent(new Event('error'))
+    expect(controller.store.getSnapshot().engineStatus).toBe('fallback')
+    expect(document.querySelector<HTMLCanvasElement>('#dsh-liquid-background')!.dataset.fallback).toBe('static')
+    controller.dispose()
+  })
+})
